# This HTTP-only phase works BEFORE the HTTPS certificate exists.
# Certbot writes tokens under templates-https/.well-known/acme-challenge/ on the host.
# The existing /etc/nginx/templates bind mount already exposes that directory.
server {
    listen 80;
    listen [::]:80;
    server_name stariy-site.ru www.stariy-site.ru;
    server_tokens off;

    location ^~ /.well-known/acme-challenge/ {
        root /etc/nginx/templates;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 308 https://stariy-site.ru$request_uri;
    }
}
