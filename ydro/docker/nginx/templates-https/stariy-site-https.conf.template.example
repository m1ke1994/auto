# Enable only AFTER the certificate exists, by copying this .example file to
# stariy-site-https.conf.template. Do not enable before issuing the certificate.
upstream vodopyanov_public {
    server vodopyanov_site:3000;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name stariy-site.ru www.stariy-site.ru;

    if ($host = www.stariy-site.ru) {
        return 301 https://stariy-site.ru$request_uri;
    }

    ssl_certificate /etc/letsencrypt/live/stariy-site.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/stariy-site.ru/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    server_tokens off;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location = /api { return 404; }
    location /api/ { return 404; }
    location = /admin { return 404; }
    location /admin/ { return 404; }
    location = /tracker.js { return 404; }
    location / {
        proxy_pass http://vodopyanov_public;
        include /etc/nginx/proxy_params;
    }
}
