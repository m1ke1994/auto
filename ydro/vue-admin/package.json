{
  "name": "vue-admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode example",
    "build": "vite build --mode production && node scripts/prerender.mjs && node scripts/check-marketing-pages.mjs",
    "build:local": "vite build --mode example && node scripts/prerender.mjs --example && node scripts/check-marketing-pages.mjs",
    "test:auth-routing": "node scripts/test-auth-routing.mjs",
    "test:seo-audit-ui": "node scripts/test-seo-audit-ui.mjs",
    "test:ai": "node scripts/test-ai-recommendations.mjs",
    "test:site-danger-zone": "node scripts/test-site-danger-zone.mjs",
    "test:tracker-integration": "node scripts/test-tracker-integration.mjs",
    "test:portfolio-media-editor": "node scripts/test-portfolio-media-editor.mjs",
    "test:tracknode-landing": "node scripts/test-tracknode-landing.mjs",
    "preview": "vite preview",
    "test:landing-story": "node scripts/check-landing-story.mjs",
    "test:landing-render": "node scripts/check-landing-render.mjs",
    "test:marketing": "node scripts/check-marketing-pages.mjs --source-only"
  },
  "dependencies": {
    "@lucide/vue": "^1.17.0",
    "axios": "^1.16.1",
    "pinia": "^3.0.4",
    "three": "^0.180.0",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.6",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.13",
    "vite": "^8.0.12"
  }
}
