APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8080
LOG_LEVEL=INFO
OPENAI_API_KEY=
OPENAI_MODEL_SEO=gpt-5-mini
OPENAI_MODEL_CONVERSION=gpt-5-mini
AI_RECOMMENDATIONS_ENABLED=True
CORE_SERVICE_TOKEN=
AI_RECOMMENDATIONS_SIGNING_SECRET=
CORE_ALLOWED_IPS=
SERVICE_PUBLIC_URL=https://ai.example.com
POSTGRES_DB=ai_recommendations
POSTGRES_USER=ai_recommendations
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://ai_recommendations:password@postgres:5432/ai_recommendations
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
REQUEST_TIMEOUT_SECONDS=120
OPENAI_TIMEOUT_SECONDS=120
MAX_RETRIES=3
JOB_RETENTION_DAYS=30
MAX_REQUEST_BODY_SIZE=1048576
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

